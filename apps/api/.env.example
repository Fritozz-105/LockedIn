# Copy to apps/api/.env and fill in. NEVER commit the real .env (it's gitignored).

# Server
NODE_ENV=development
PORT=3000

# Supabase project URL (not secret). Dashboard → Project Settings → Data API → URL
# e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Postgres connection string — use the TRANSACTION POOLER (port 6543).
# Dashboard → Connect → "Transaction pooler". Contains the DB password — SECRET.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Anon/publishable key — used only by the local test script to mint a JWT.
# Dashboard → Project Settings → API Keys (publishable sb_publishable_..., or legacy anon).
SUPABASE_ANON_KEY=

# A test user you create (Dashboard → Authentication → Users → Add user), used
# only by `pnpm --filter @lockedin/api token` to mint a JWT for curling /me.
TEST_EMAIL=
TEST_PASSWORD=
